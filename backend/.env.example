# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gestao_ti
DATABASE_SSL=false

# JWT Configuration
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Inter Banking (optional)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
INTER_ENVIRONMENT=sandbox
INTER_ACCOUNT=

# Evolution API (WhatsApp) - optional; also configurable via Administração > WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Security keys (required in production)
CERT_ENCRYPTION_KEY=
CERT_ENCRYPTION_KEY_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
SUPER_ADMIN_JWT_SECRET=
INTER_WEBHOOK_SECRET=
INTER_WEBHOOK_RATE_LIMIT=60
