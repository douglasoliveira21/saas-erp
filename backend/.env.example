# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gestao_ti
DATABASE_SSL=false

# JWT Configuration
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
# Em producao use o dominio do ERP (ex.: https://erp.seudominio.com.br); "*" so para desenvolvimento.
CORS_ORIGIN=*

# Inter Banking (optional)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
INTER_ENVIRONMENT=sandbox
INTER_ACCOUNT=

# Evolution API (WhatsApp) - optional; also configurable via Administração > WhatsApp
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Security keys (required in production)
CERT_ENCRYPTION_KEY=
CERT_ENCRYPTION_KEY_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
SUPER_ADMIN_JWT_SECRET=
INTER_WEBHOOK_SECRET=
INTER_WEBHOOK_RATE_LIMIT=60

# Captcha Cloudflare Turnstile no login (vazio = desligado). A site key publica vai no build do frontend (VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# Isolamento por tenant: "off" desliga o filtro automatico por tenant (uso de emergencia).
TENANT_SCOPING=on

# Limite de requisicoes por minuto (em memoria, por instancia). RATE_LIMIT=off desliga.
RATE_LIMIT=on
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_PUBLIC_PER_MIN=40

# Conta de e-mail da PLATAFORMA (recuperacao de senha de usuarios e codigo 2FA do super admin).
# Os e-mails de cada empresa (boletos, notas, avisos) saem so pela conta que o proprio tenant
# cadastra em Administracao > Configuracao de e-mail; nao ha mais conta padrao embutida no codigo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
